    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": "./build_Runner-game/Runner-game.axf",
            "configFiles": [
                "/usr/share/openocd/scripts/interface/stlink.cfg",
                "/usr/share/openocd/scripts/target/stm32l1.cfg"
            ],
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "gdbPath": "/usr/bin/gdb-multiarch",
            //"gdbPath": "/home/giahuy/workspace/tools/gcc-arm-none-eabi-10.3-2021.10/bin/arm-none-eabi-gdb",
            "stlinkPath": "/usr/bin/st-flash",
            "showDevDebugOutput": "raw",
            "liveWatch": true,
        }
    ]
}